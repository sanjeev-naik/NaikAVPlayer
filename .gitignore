# Build trees. CMake is configured out-of-source; every build-* directory
# here is disposable and regenerated by a configure step.
build/
build-*/
build_*/
cmake-build-*/
out/
CMakeUserPresets.json

# FFmpeg is downloaded into thirdparty/ffmpeg by CMakeLists.txt when it is
# missing (see the FFMPEG_DIR block), so it is a build artifact, not a
# vendored source drop.
thirdparty/

# Coverage output (gcovr/lcov HTML and the raw counters).
coverage_html/
coverage_report.html
coverage.info
*.gcda
*.gcno

# Runtime state the player writes next to the executable. These are
# per-machine and would conflict on every pull.
imgui.ini
player_settings.txt
playlist.m3u8

# Media used for local playback testing. Large binaries that must never
# reach the history.
*.mkv
*.mp4
*.mov
*.m4v
*.webm
*.avi
*.ts
*.mp3
*.flac
*.wav
*.aac
*.ac3
*.opus

# Editor / OS noise.
.vs/
.vscode/
.idea/
*.user
Thumbs.db
desktop.ini
.DS_Store

# Compiled objects and binaries left outside a build tree.
*.o
*.obj
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.pdb
*.ilk

# Python bytecode from local tooling.
__pycache__/
*.pyc
